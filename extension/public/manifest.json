{
    "manifest_version": 3,
    "name": "MisInfo Guard",
    "version": "0.1.0",
    "description": "Real-time misinformation detection and highlighting",
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_title": "MisInfo Guard"
    },
    "options_ui": {
        "page": "src/options/options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content/index.ts"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://generativelanguage.googleapis.com/*",
        "https://api.sarvam.ai/*",
        "https://api.tavily.com/*",
        "https://github.com/raghavthind2005/MisInfo-Guard/releases/*",
        "https://release-assets.githubusercontent.com/*",
        "https://objects.githubusercontent.com/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*",
                "models/tinybert-claim-detector/*",
                "models/tinybert-claim-detector/onnx/*",
                "wasm/*.wasm"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+M",
                "mac": "Command+Shift+M"
            }
        }
    }
}
